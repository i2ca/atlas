<?xml version="1.0"?>
<!--
  Porto de celulose para a simulacao da empilhadeira: o big_depot com a frente sul aberta para o patio
  (cobertura, faixa de pedestre, patio, cais, navio com guindastes, caminhoes, cones, postes).
  GERADO por tools/make_port_world.py a partir do big_depot.sdf -- edite o gerador, nao este arquivo.
  Galpao: pecas do "Depot" (OpenRobotics) e colisoes do "tugbot_depot" (MovAi), Gazebo Fuel, CC-BY 4.0.
  Porto: navio e caminhao de poly.pizza (CC BY 3.0, worlds/models/ATTRIBUTION.txt), resto primitivas. Inicio sugerido no patio: x 5, y -27, yaw 0 (ou dentro do galpao: 0.2, 8.8).
-->
<sdf version="1.9">
  <world name="port">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>900 900</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>900 900</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="big_depot">
      <static>true</static>
      <link name="main">
        <visual name="ROOF_visual">
          <pose>40.800 26.846 0.000 0 0 0</pose>
                <geometry>
                    <mesh>
                        <scale>2.2512 3.1732 0.8000</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/meshes/Depot.dae</uri>
                        <submesh>
                            <name>ROOF</name>
                            <center>false</center>
                        </submesh>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0</specular>
                    <pbr>
                        <metal>
                            <albedo_map>https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/materials/textures/ROOF_Albedo.png</albedo_map>
                            <normal_map>https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/materials/textures/ROOF_Normal.png</normal_map>
                            <metalness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/materials/textures/ROOF_Metalness.png</metalness_map>
                            <roughness_map>https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/materials/textures/ROOF_Roughness.png</roughness_map>
                            <emissive_map>https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/materials/textures/ROOF_Emissive.png</emissive_map>
                            <light_map uv_set="1">https://fuel.gazebosim.org/1.0/openrobotics/models/depot/6/files/materials/textures/DepotLightmap.png</light_map>
                        </metal>
                    </pbr>
                </material>
        </visual>

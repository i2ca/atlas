<link name="Garra_1_1">
  <inertial>
    <origin xyz="0.25314091830770374 -0.34996483420745594 -0.41637599264107417" rpy="0 0 0"/>
    <mass value="980.1329836469724"/>
    <inertia ixx="237.854536" iyy="187.973293" izz="244.401542" ixy="-64.814959" iyz="-53.91832" ixz="-31.272353"/>
  </inertial>
  <visual>
    <origin xyz="0.72609 -0.45169 -4.25807" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find Hyster_description)/meshes/Garra_1_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="steel_grey"/>
  </visual>
  <!-- Flat pad instead of the STL: the mesh's inner face flares towards the tip
       and wedges the load out when the clamp closes -->
  <collision>
    <origin xyz="0.04009 -0.77719 -0.65157" rpy="0 0 0"/>
    <geometry>
      <box size="0.08 1.425 0.507"/>
    </geometry>
  </collision>
</link>


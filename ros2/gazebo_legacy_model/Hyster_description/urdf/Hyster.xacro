<!-- Implement joints, driven by libhyster_joint_position.so. Positive values:
     lift joints raise, clamp_base_joint shifts to the vehicle's left (+X of
     base_link), clamp joints close. Mast tilt stays locked. -->
<joint name="clamp_base_joint" type="prismatic">
  <origin xyz="1.0175 -0.837985 -5.348533" rpy="0 0 0"/>
  <parent link="Base_deslizante_1"/>
  <child link="Base_das_garras_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit lower="-0.3" upper="0.3" effort="100000" velocity="1.0"/>
</joint>

<joint name="mast_lift_joint" type="prismatic">
  <origin xyz="-0.965023 4.801702 1.25027" rpy="0 0 0"/>
  <parent link="Frame_1_1"/>
  <child link="mast_inner"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit lower="0.0" upper="2.65" effort="300000" velocity="1.0"/>
</joint>

<joint name="mast_tilt_joint" type="fixed">
  <origin xyz="-0.45175 1.105433 3.11971" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Frame_1_1"/>
</joint>

<joint name="carriage_joint" type="prismatic">
  <origin xyz="1.415593 -4.452203 4.951004" rpy="0 0 0"/>
  <parent link="mast_inner"/>
  <child link="Base_deslizante_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit lower="-0.25" upper="2.3" effort="300000" velocity="1.0"/>
</joint>

<joint name="clamp_1_joint" type="prismatic">
  <origin xyz="-1.74241 -0.165257 0.285619" rpy="0 0 0"/>
  <parent link="Base_das_garras_1"/>
  <child link="Garra_1_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit lower="0.0" upper="0.45" effort="100000" velocity="1.0"/>
</joint>

<joint name="clamp_2_joint" type="prismatic">
  <origin xyz="-0.29241 -0.165257 -0.514381" rpy="0 0 0"/>
  <parent link="Base_das_garras_1"/>
  <child link="Garra_2_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <limit lower="0.0" upper="0.45" effort="100000" velocity="1.0"/>
</joint>

<joint name="right_tilt_cylinder_joint" type="fixed">
  <origin xyz="0.527625 1.425994 3.935058" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_tilt_cylinder"/>
</joint>

<joint name="left_tilt_cylinder_joint" type="fixed">
  <origin xyz="-0.527625 1.425994 3.935058" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_tilt_cylinder"/>
</joint>

<!-- Wheels: all axes along +X so positive velocity drives towards the clamps (-Y of base_link) -->
<joint name="left_front_wheel_joint" type="continuous">
  <origin xyz="-0.4705 1.170433 3.26971" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Left_front_wheel_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="right_front_wheel_joint" type="continuous">
  <origin xyz="0.4705 1.170433 3.26971" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Right_front_wheel_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="left_rear_wheel_joint" type="continuous">
  <origin xyz="-0.17 0.0 -0.115" rpy="0 0 0"/>
  <parent link="left_hub"/>
  <child link="Left_rear_wheel_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<joint name="right_rear_wheel_joint" type="continuous">
  <origin xyz="0.17 0.0 -0.115" rpy="0 0 0"/>
  <parent link="right_hub"/>
  <child link="Right_rear_wheel_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

<!-- Rear steering: axis is -Z so the ackermann plugin's front-steer geometry holds for a rear-steered vehicle -->
<joint name="right_hub_steer_joint" type="revolute">
  <origin xyz="0.607 3.405433 3.37921" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_hub"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="0.6" lower="-0.6" effort="100000" velocity="100"/>
  <dynamics damping="50"/>
</joint>

<joint name="left_hub_steer_joint" type="revolute">
  <origin xyz="-0.607 3.405433 3.37921" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_hub"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="0.6" lower="-0.6" effort="100000" velocity="100"/>
  <dynamics damping="50"/>
</joint>

</robot>

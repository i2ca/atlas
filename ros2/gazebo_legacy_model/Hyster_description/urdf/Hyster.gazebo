<?xml version="1.0" ?>
<robot name="Hyster" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!-- Visual color for Gazebo Classic; RGBA properties come from materials.xacro -->
<xacro:macro name="gazebo_color" params="rgba">
  <visual>
    <material>
      <ambient>${rgba}</ambient>
      <diffuse>${rgba}</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </material>
  </visual>
</xacro:macro>
<gazebo>
  <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
    <update_rate>100</update_rate>
    <!-- The plugin's "front" is the steered axle, which is the rear of the forklift.
         Sides follow geometry (+X of base_link is the left side when driving
         towards the clamps); the CAD Left/Right names are mirrored. -->
    <front_left_joint>right_rear_wheel_joint</front_left_joint>
    <front_right_joint>left_rear_wheel_joint</front_right_joint>
    <rear_left_joint>right_front_wheel_joint</rear_left_joint>
    <rear_right_joint>left_front_wheel_joint</rear_right_joint>
    <left_steering_joint>right_hub_steer_joint</left_steering_joint>
    <right_steering_joint>left_hub_steer_joint</right_steering_joint>
    <!-- cmd_vel angular.z is taken as the steering angle in rad -->
    <max_steer>0.6</max_steer>
    <max_speed>5</max_speed>
    <left_steering_pid_gain>100000 0 10000</left_steering_pid_gain>
    <left_steering_i_range>0 0</left_steering_i_range>
    <right_steering_pid_gain>100000 0 10000</right_steering_pid_gain>
    <right_steering_i_range>0 0</right_steering_i_range>
    <linear_velocity_pid_gain>60000 0 10</linear_velocity_pid_gain>
    <linear_velocity_i_range>0 0</linear_velocity_i_range>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>false</publish_wheel_tf>
    <publish_distance>false</publish_distance>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_footprint</robot_base_frame>
  </plugin>
  <plugin name="implement_control" filename="libhyster_joint_position.so">
    <gain>5.0</gain>
    <controlled_joint name="carriage_joint">
      <max_velocity>0.3</max_velocity>
      <max_force>300000</max_force>
    </controlled_joint>
    <controlled_joint name="mast_lift_joint">
      <max_velocity>0.3</max_velocity>
      <max_force>300000</max_force>
    </controlled_joint>
    <controlled_joint name="clamp_base_joint">
      <max_velocity>0.15</max_velocity>
      <max_force>100000</max_force>
    </controlled_joint>
    <!-- max_force on the clamp joints is the grip force on the load -->
    <controlled_joint name="clamp_1_joint">
      <max_velocity>0.15</max_velocity>
      <max_force>5000</max_force>
    </controlled_joint>
    <controlled_joint name="clamp_2_joint">
      <max_velocity>0.15</max_velocity>
      <max_force>5000</max_force>
    </controlled_joint>
    <!-- A load pressed by both arms is attached to the clamp base until they open -->
    <gripper>
      <joint>clamp_1_joint</joint>
      <joint>clamp_2_joint</joint>
    </gripper>
  </plugin>
  <plugin name="joint_states" filename="libgazebo_ros_joint_state_publisher.so">
    <update_rate>50</update_rate>
    <joint_name>left_front_wheel_joint</joint_name>
    <joint_name>right_front_wheel_joint</joint_name>
    <joint_name>left_rear_wheel_joint</joint_name>
    <joint_name>right_rear_wheel_joint</joint_name>
    <joint_name>left_hub_steer_joint</joint_name>
    <joint_name>right_hub_steer_joint</joint_name>
    <joint_name>carriage_joint</joint_name>
    <joint_name>mast_lift_joint</joint_name>
    <joint_name>clamp_base_joint</joint_name>
    <joint_name>clamp_1_joint</joint_name>
    <joint_name>clamp_2_joint</joint_name>
  </plugin>
</gazebo>
<gazebo reference="base_link">
  <xacro:gazebo_color rgba="${hyster_yellow_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="Base_das_garras_1">
  <xacro:gazebo_color rgba="${steel_grey_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="mast_inner">
  <xacro:gazebo_color rgba="${mast_black_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="Frame_1_1">
  <xacro:gazebo_color rgba="${mast_black_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="Base_deslizante_1">
  <xacro:gazebo_color rgba="${mast_black_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="Left_front_wheel_1">
  <xacro:gazebo_color rgba="${tire_black_rgba}"/>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>

<gazebo reference="Right_front_wheel_1">
  <xacro:gazebo_color rgba="${tire_black_rgba}"/>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>

<gazebo reference="Left_rear_wheel_1">
  <xacro:gazebo_color rgba="${tire_black_rgba}"/>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>

<gazebo reference="Right_rear_wheel_1">
  <xacro:gazebo_color rgba="${tire_black_rgba}"/>
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>

<gazebo reference="right_hub">
  <xacro:gazebo_color rgba="${dark_grey_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="left_hub">
  <xacro:gazebo_color rgba="${dark_grey_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="Garra_1_1">
  <xacro:gazebo_color rgba="${steel_grey_rgba}"/>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
</gazebo>

<gazebo reference="Garra_2_1">
  <xacro:gazebo_color rgba="${steel_grey_rgba}"/>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
</gazebo>

<gazebo reference="right_tilt_cylinder">
  <xacro:gazebo_color rgba="${chrome_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

<gazebo reference="left_tilt_cylinder">
  <xacro:gazebo_color rgba="${chrome_rgba}"/>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
</gazebo>

</robot>
